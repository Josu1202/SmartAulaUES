# Copy to a private path outside the checkout and restrict its permissions (0600).
# Replace every REQUIRED value before invoking Compose. Never commit the filled file.
COMPOSE_PROJECT_NAME=smartaulaues-production
SMARTAULAUES_IMAGE_TAG=local
PRODUCTION_APP_URL=https://REQUIRED_DOMAIN
PRODUCTION_HTTP_PORT=8086
PRODUCTION_DB_DATABASE=smartaulaues
DB_USERNAME=smartaulaues
DB_PASSWORD=REQUIRED_RANDOM_DATABASE_PASSWORD
APP_KEY=REQUIRED_EXISTING_KEY_OR_NEW_INSTALLATION_KEY
# Actual reverse proxy IP/CIDR only. Empty means no trusted proxy.
SMARTAULAUES_TRUSTED_PROXIES=
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
