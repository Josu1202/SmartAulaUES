APP_NAME=SmartAulaUES
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=pgsql
# Dirección desde el equipo: Docker publica 55432. PostgreSQL local: adapta su puerto real.
# Dentro del contenedor, Compose define DB_HOST=db y DB_PORT=5432.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=siaa
DB_USERNAME=siaa
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=private
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME=SmartAulaUES
VITE_APP_NAME=SmartAulaUES
SMARTAULAUES_DISPLAY_TIMEZONE=America/El_Salvador
# Vacío para HTTP local. Para el túnel Docker de pruebas: * (app publicada solo en 127.0.0.1).
# En un servidor definitivo, especifica las IP/CIDR reales de los proxies separados por comas.
SMARTAULAUES_TRUSTED_PROXIES=
DEMO_SEED=true
DEMO_PASSWORD=
# Opcional: docker compose --profile tools up -d pgadmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
# HTTPS: APP_URL=https://tu-dominio + SESSION_SECURE_COOKIE=true.
# Pruebas con celular: docs/mobile-https.md.
# Producción: APP_ENV=production + APP_DEBUG=false + DEMO_SEED=false.
